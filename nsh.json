{
  "name": "Petal",
  "id": "dev.petal.app",
  "version": "0.1.0",
  "build": 1,
  "nsh": ">=0.7",
  "theme": "theme.json",
  "rust": ".",
  "window": {
    "title": "Petal",
    "defaultSize": { "width": 1320, "height": 840 },
    "minSize": { "width": 720, "height": 520 }
  },
  "capabilities": {
    "network": { "hosts": ["*"] },
    "clipboard": true,
    "statusBar": true,
    "application": true,
    "picker": true,
    "homeDir": true,
    "fs": {
      "read": ["${dataDir}", "${homeDir}/Downloads"],
      "write": ["${dataDir}", "${homeDir}/Downloads"]
    }
  },
  "dependencies": {
    "nsh-graph": "^0.3.0"
  }
}
